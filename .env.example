APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://sam:sam-local-only@localhost:5432/sam
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO
BOOTSTRAP_ADMIN_EMAIL=admin@sam.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-use
PUBLIC_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional customer integrations. Configure through the customer secret manager in deployed environments.
QUALYS_BASE_URL=
QUALYS_USERNAME=
QUALYS_PASSWORD=
QUALYS_API_VERSION=6.0
SERVICENOW_BASE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TABLES=cmdb_ci_server,cmdb_ci_web_application
SERVICENOW_EXPOSURE_FIELD=
SERVICENOW_ENVIRONMENT_FIELD=environment
SERVICENOW_CRITICALITY_FIELD=business_criticality
SERVICENOW_TICKET_WRITE_ENABLED=false
SERVICENOW_INCIDENT_TABLE=incident
SERVICENOW_TICKET_BASE_URL=
SERVICENOW_TICKET_USERNAME=
SERVICENOW_TICKET_PASSWORD=
# Optional AI analyst. Data remains local unless all enablement and approval flags are true.
AI_ANALYST_ENABLED=false
AI_ANALYST_DATA_APPROVED=false
AI_ANALYST_API_KEY=
AI_ANALYST_MODEL=
AI_ANALYST_BASE_URL=https://api.openai.com/v1
AI_ANALYST_MAX_OUTPUT_TOKENS=600
# Public threat-feed endpoints. Override only with an approved HTTPS feed mirror.
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
CERTSPOTTER_BASE_URL=https://api.certspotter.com
CERTSPOTTER_API_TOKEN=
EXTERNAL_DISCOVERY_MAX_PAGES=100
INTEGRATION_TIMEOUT_SECONDS=15
INTEGRATION_MAX_PAGES=100
IDEMPOTENCY_RETENTION_DAYS=7
